**File: `eStoreCA.Application/Features/{EntityName}/Queries/GetById/GetById{EntityName}QueryHandler.cs`**
```csharp
// Start GetById Query Code
namespace eStoreCA.Application.Features.Queries
{
    #region GetById Query Parameters
    [Authorize(Policy = AppPermissions.{EntityName}Permissions.View)]
    public class GetById{EntityName}Query : GetById{EntityName}QueryDto, IRequest<MyAppResponse<GetById{EntityName}Dto>>
    {
    }
    #endregion
    #region GetById Query Handler
    public class GetById{EntityName}QueryHandler : GetById{EntityName}QueryDto, IRequestHandler<GetById{EntityName}Query, MyAppResponse<GetById{EntityName}Dto>>
    {
        private readonly IApplicationDbContext _dbContext;

        public GetById{EntityName}QueryHandler(IApplicationDbContext dbContext)
        {
            _dbContext = dbContext;
        }
        public async ValueTask<MyAppResponse<GetById{EntityName}Dto>> Handle(GetById{EntityName}Query request, CancellationToken cancellationToken)
        {
            var query = _dbContext.{EntityName Plural}.AsQueryable();

            var result = await query.FirstOrDefaultAsync(o => o.Id == request.Id, cancellationToken);

            if (result != null)
            {
                return new MyAppResponse<GetById{EntityName}Dto>(result.Adapt<GetById{EntityName}Dto>());
            }
            return new MyAppResponse<GetById{EntityName}Dto>(data: null);
        }
    }
    #endregion
}
// End GetById Query Code
